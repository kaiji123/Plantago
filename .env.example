# --- PayPal (sandbox) ---
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave both blank to run in simulation mode (no real sandbox transactions).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook ID from the developer dashboard, enables signature checks.
PAYPAL_WEBHOOK_ID=
# Optional: send every grower payout to this sandbox personal account
# so you can log in and see the money arrive.
PAYPAL_PAYOUT_RECEIVER_OVERRIDE=

# --- AI planner (DeepSeek by default; any OpenAI-compatible API works) ---
# Get a key at https://platform.deepseek.com/api_keys . Leave blank to use the rule-based planner.
DEEPSEEK_API_KEY=
PLANNER_MODEL=deepseek-flash
# Optional: another OpenAI-compatible provider
# PLANNER_BASE_URL=https://api.deepseek.com
# PLANNER_API_KEY=
# PLANNER_REASONING_EFFORT=high
# PLANNER_THINKING=on

# --- App ---
PORT=8787
DATABASE_PATH=./data/plantago.db
# Operator pages (payout batches, shipments) need this token. Blank = open (local dev only).
OPERATOR_TOKEN=
# Payouts run automatically once a destination's unpaid plans reach this amount.
PAYOUT_THRESHOLD_USD=100
