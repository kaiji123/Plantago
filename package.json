{
  "name": "plantago",
  "version": "0.1.0",
  "private": true,
  "description": "PayPal donations turned into food grown or bought close to the people who need it, planned by AI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test server/*.test.ts",
    "seed:reset": "tsx server/scripts/reset.ts",
    "check": "tsx server/scripts/check.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "openai": "^7.45.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
